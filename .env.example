# Copy to project-local .env; keep all credentials private.
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
AI_MAX_CALLS=20
# Explicit spending ceiling required before any generated answer.
AI_MAX_AMOUNT_USD=
